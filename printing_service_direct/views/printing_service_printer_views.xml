<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_printing_service_printer_form" model="ir.ui.view">
        <field name="name">printing.service.printer.form</field>
        <field name="model">printing.service.printer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="service_id"/>
                        <field name="printer_uuid"/>
                        <field name="printer_type"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_printing_service_printer_list" model="ir.ui.view">
        <field name="name">printing.service.printer.list</field>
        <field name="model">printing.service.printer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="service_id"/>
                <field name="printer_type"/>
                <field name="printer_uuid"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_printing_service_printer" model="ir.actions.act_window">
        <field name="name">Printers</field>
        <field name="res_model">printing.service.printer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
