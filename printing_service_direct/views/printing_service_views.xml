<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_printing_service_form" model="ir.ui.view">
        <field name="name">printing.service.form</field>
        <field name="model">printing.service</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" string="Test Connection"
                        type="object" class="btn-secondary"/>
                    <button name="action_refresh_printers" string="Refresh Printers"
                        type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Print Service"/>
                        </h1>
                    </div>
                    <group>
                        <field name="url" placeholder="https://print-service.hz.ledoweb.com"/>
                        <field name="api_key" password="True"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Printers">
                            <field name="printer_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="printer_type"/>
                                    <field name="printer_uuid"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_printing_service_list" model="ir.ui.view">
        <field name="name">printing.service.list</field>
        <field name="model">printing.service</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="url"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_printing_service" model="ir.actions.act_window">
        <field name="name">Print Service Config</field>
        <field name="res_model">printing.service</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
